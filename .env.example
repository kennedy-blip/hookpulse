# Persistent event storage (recommended for Vercel production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC-SHA256 signing secrets. Set provider-specific values where possible.
GITHUB_WEBHOOK_SECRET=
MPESA_WEBHOOK_SECRET=
AGENT_WEBHOOK_SECRET=
# Optional fallback secret used when a provider-specific secret is not set.
WEBHOOK_SECRET=

# Optional outbound relay. Keep this URL server-side; never use a VITE_ prefix.
FORWARD_WEBHOOK_URL=
FORWARD_WEBHOOK_TOKEN=
